# Copy this file to .env and fill in your own values.
# Get KITE_API_KEY / KITE_API_SECRET from developers.kite.trade after
# subscribing to the Connect plan (₹500/month, covers the market data
# this app needs - see README.md).

KITE_API_KEY=
KITE_API_SECRET=

# Must exactly match the "Redirect URL" you set in your Kite Connect
# app settings. For local testing: http://localhost:5000/kite/callback
# For a real server: http://YOUR_SERVER_IP:5000/kite/callback (or your
# domain, ideally with https once you set that up).
REDIRECT_URL=http://localhost:5000/kite/callback

# Required once this is on a public server - a shared password so
# random visitors can't see your signals or trigger your Kite login.
# Pick something long and random.
DASHBOARD_PASSWORD=

# Optional - only needed for the "AI Insights" panel on the dashboard.
# Get a key at console.anthropic.com. Leave blank to hide that panel.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional - only needed for Telegram push alerts when a signal fires
# (works even with the dashboard closed). Leave both blank to skip -
# you'll still get in-page toast+sound alerts whenever the tab is open.
# Setup: message @BotFather on Telegram -> /newbot -> paste the token
# below -> message your new bot once -> use "Find my chat ID" on the
# Settings page to get TELEGRAM_CHAT_ID. See README "Alerts" section.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --------------------------------------------------------------------
# Everything below is just the STARTING point. Once the app is running,
# use the Settings page in the dashboard to change watchlist, timeframe,
# and indicator parameters live, with no restart needed - these values
# only matter the very first time the app starts (before
# scanner_settings.json exists).
# --------------------------------------------------------------------

# Comma-separated NSE trading symbols to scan. You can also click
# "Load current F&O list from Kite" on the Settings page once logged in
# to replace this with the exact, live list of NSE F&O-eligible stocks
# pulled straight from Kite's own instrument list - no manual list to
# keep up to date.
WATCHLIST=RELIANCE,TCS,HDFCBANK,ICICIBANK,INFY,HINDUNILVR,ITC,SBIN,BHARTIARTL,KOTAKBANK,LT,AXISBANK,BAJFINANCE,MARUTI,SUNPHARMA,TITAN,ULTRACEMCO,WIPRO,ONGC,TATAMOTORS

# One of: 15minute | 30minute | 60minute | 4hour | day | week
# (4hour is synthesized by resampling Kite's 60-minute candles - Kite
# has no native 4-hour interval.)
TIMEFRAME=15minute

# One of: auto | 15min | 30min | custom
MACD_PRESET=auto
MACD_CUSTOM_FAST=12
MACD_CUSTOM_SLOW=26
MACD_CUSTOM_SIGNAL=9

RSI_LENGTH=9
RSI_SMOOTH_LENGTH=9
EMA_LENGTH=9
BB_LENGTH=20

# 3-of-4 state confirmation is the default. Best Entries additionally requires
# a fresh RSI/MACD/CMF crossover trigger, so state alignment cannot become a late entry.
MIN_REQUIRED=3

# How often (seconds) the background scanner re-checks the watchlist.
SCAN_INTERVAL_SECONDS=180

# Overnight continuation alerts stay off until the Backtest page shows a positive holdout edge.
BTST_ALERT_ENABLED=false

# V8.2 Derivative Intelligence (live/shadow; stock-option IV/Greeks are model estimates)
OPTION_SHADOW_FILE=option_shadow.jsonl
OPTION_SHADOW_STATE_FILE=option_shadow_state.json
OPTION_RISK_FREE_RATE=0.06

# Durable research checkpoint directory. Default is local app storage. On Railway,
# mount a persistent Volume (for example at /data) and set this to
# /data/dbindicator-research. Both job state and per-symbol/rank checkpoints live
# underneath this one root, so completed work can survive a worker/container restart.
RESEARCH_STATE_DIR=.dbindicator-research

# V9.4 magnitude research. Research cache should live on the same persistent volume as RESEARCH_STATE_DIR.
# V94_DAILY_OI_CACHE_FILE=.dbindicator-research/v94-daily-oi-live.json
# V94_MAX_LIVE_MAGNITUDE_CANDIDATES=6
# Optional extra round-trip option execution drag after executable ask-entry/bid-exit spread capture.
# OPTION_EXECUTION_EXTRA_COST_PCT=0.0

# V12.0 forward option-edge recorder runtime paths. Keep defaults unless the
# deployment uses a mounted persistent volume. These are not secrets.
# V12_OPTION_SNAPSHOT_FILE=v12_option_snapshots.jsonl
# V12_OPTION_STATE_FILE=v12_option_state.json
# V12_EARNINGS_LEDGER_FILE=v12_earnings_ledger.jsonl
# V12_EARNINGS_STATE_FILE=v12_earnings_state.json
# V12_SNAPSHOT_GRACE_MINUTES=7
# V12_DEEP_SYMBOL_LIMIT=40
